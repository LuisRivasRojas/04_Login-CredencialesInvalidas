{
  "info": {
    "name": "EventPass - Login (Equipo 04)",
    "description": "Pruebas automatizadas de login con credenciales inválidas contra el endpoint POST /api/login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CP-01 - Contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"usuario.prueba@correo.com\",\n  \"contrasena\": \"ClaveIncorrecta999\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CP-01: status code es 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('CP-01: exitoso es false', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.exitoso).to.eql(false);",
              "});",
              "",
              "pm.test('CP-01: mensaje es Credenciales incorrectas', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.mensaje).to.eql('Credenciales incorrectas');",
              "});"
            ]
          }
        }
      ]
    },
